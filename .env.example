# Copy this file to .env to change settings. Everything is optional.

# Which LLM writes the answers: "ollama" (local, default) or "claude"
# CLINICBOT_PROVIDER=ollama

# Local model (must be pulled first: ollama pull <name>)
# CLINICBOT_OLLAMA_MODEL=qwen3:4b

# Only needed when CLINICBOT_PROVIDER=claude
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
# CLINICBOT_MODEL=claude-opus-5-5
